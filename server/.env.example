# ---- Server ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API (the React dev server by default)
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind one reverse proxy (nginx, Render, Railway...) so rate limits see real client IPs
TRUST_PROXY=0

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017/interview-coach
MONGO_AUTO_INDEX=true

# ---- Auth ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=30
REFRESH_REUSE_LEEWAY_SECONDS=10
BCRYPT_ROUNDS=12
# Defaults to true in production. Set false only when serving over plain HTTP (e.g. local Docker).
# COOKIE_SECURE=false

# ---- Gemini (free key: https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ---- Retrieval ----
# local = exact search inside the app (works on any MongoDB). atlas = MongoDB Atlas $vectorSearch (see README).
VECTOR_STORE=local
ATLAS_VECTOR_INDEX=resume_chunks_vector

# ---- Limits ----
MAX_UPLOAD_MB=5
MAX_RESUMES_PER_USER=5
MAX_CHUNKS_PER_RESUME=60
RATE_LIMIT_ENABLED=true
